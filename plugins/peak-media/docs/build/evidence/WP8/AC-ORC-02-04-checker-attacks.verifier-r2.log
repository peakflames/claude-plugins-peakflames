# harness source (attack.mjs)
import { writeFileSync, mkdirSync } from 'node:fs';
import path from 'node:path';
import { goodSteps, render } from './gen.mjs';
const PMD = process.argv[2]; const T = process.argv[3];
const { loadTranscript, checkAll } = await import(path.join(PMD, 'evals/plate-factory/transcript.mjs'));
const ROOT = '/opt/plugins/peak-media'; const P = '/home/user/videos/orc-01';
const node = (s, a) => `node "${ROOT}/${s}" ${a}`;
const RP = (a) => `cd ${P} && ${node('skills/video-plates/scripts/render-plate.mjs', a)}`;
const SHEET = (mp4, out) => `cd ${P} && ${node('lib/verify/contact-sheet.mjs', `${mp4} --every 0.5s -o ${out}`)}`;
const idx = (s, f) => s.findIndex(f);
const sayIdx = (s, n) => idx(s, (x) => x[0] === 'say' && x[1].includes(`GATE ${n} `));
