  if (bad.length) defects++;
  rows.push(`${bad.length ? 'DEFECT' : 'ok    '}  ${label}\n        expect ${Object.entries(expect).map(([k, v]) => `${k} ${v}`).join('; ')}\n` + res.map((r) => `        ${r.ok ? 'PASS' : 'FAIL'} ${r.id.slice(3)}: ${r.message}`).join('\n'));
