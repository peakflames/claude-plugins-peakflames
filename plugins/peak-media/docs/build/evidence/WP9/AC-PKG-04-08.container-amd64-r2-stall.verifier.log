#!/usr/bin/env bash
# Verifier WP9: fresh node:22-slim; /repo = worktree mounted read-only.
set -uo pipefail
export DEBIAN_FRONTEND=noninteractive
cd /repo/plugins/peak-media
echo "## container: $(uname -m) · $(. /etc/os-release && echo "$PRETTY_NAME") · node $(node -v)"
echo "## V0 — nothing installed: setup.sh (install mode) and --check"
bash scripts/setup.sh; echo "exit $?"
bash scripts/setup.sh --check; echo "exit $?"
echo "## V1 — apt-get install ffmpeg ca-certificates only (no browser libs), then setup.sh"
apt-get update -qq >/dev/null && apt-get install -y -qq --no-install-recommends ffmpeg ca-certificates >/dev/null 2>&1; echo "apt exit $?"
bash scripts/setup.sh -q; echo "exit $?"
echo "## V1b — setup.sh --check with libs missing"
bash scripts/setup.sh --check; echo "exit $?"
echo "## V2 — README's Linux package line"
PKGS="ffmpeg ca-certificates libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 libxcomposite1 libxdamage1"
echo "apt-get install -y --no-install-recommends $PKGS"
apt-get install -y -qq --no-install-recommends $PKGS >/dev/null 2>&1; echo "apt exit $?"
bash scripts/setup.sh; echo "exit $?"
bash scripts/setup.sh --check; echo "exit $?"
B=$(ls /root/.cache/hyperframes/chrome/chrome-headless-shell/*/*/chrome-headless-shell 2>/dev/null | head -1)
echo "browser: $B"; [ -n "$B" ] && { ldd "$B" | grep "not found" || echo "ldd: nothing missing"; }
echo "## V3 — AC-PKG-04 and AC-PKG-08 evals"
export TMPDIR=$(mktemp -d)
node --test --test-reporter=spec --test-name-pattern='^AC-PKG-0[48]:' 'evals/packaging/*.test.mjs'
code=$?; echo "node --test exit $code"
echo "## TMPDIR left: $(find "$TMPDIR" -mindepth 1 -maxdepth 1 | wc -l) entries"; ls -A "$TMPDIR"
exit $code
