cat > brief.md <<'EOF'
# Water in the morning — deck video

- **Runtime:** 20 s target
- **Audience:** home gardeners watching on YouTube; no gardening background assumed
- **Destination:** YouTube (preset: youtube), 1920×1080, 30 fps
- **Mode:** narrated (voice Rasalgethi); the capture plays to the spine's clip timing
- **Source:** `../../deck/index.html`, a three-slide web deck

## Beats

1. **intro** (live) — slide 1, the habit
2. **why** (live) — slide 2, two reasons
3. **how** (live) — slide 3, how to water
EOF
cat > storyboard.mjs <<'EOF'
// One beat per slide: `intro`, `why`, `how` from script.md. Slide changes happen between beats,
// so in the narrated take they land in the silence between clips.
export const url = '../../deck/index.html';

const SLIDES = ['intro', 'why', 'how'];

export default async function storyboard({ beat, page, wait }) {
  for (const [n, id] of SLIDES.entries()) {
    if (n) await wait(250);                           // let the last word ring out
    await page.evaluate((i) => window.deckGo(i), n); // between beats: lands in silence
    await wait(900);                                  // let the slide settle before the voice
    await beat(id);                                   // no fn: the slide is the picture
  }
}
EOF
