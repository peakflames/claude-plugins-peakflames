      "durationMs": 5000,
      "intent": "Pick OpenSpec when…",
      "assets": [],
      "text": [
        "Pick OpenSpec when…",
        "existing codebase, light guardrails",
        "mixed assistants",
        "\"agree before you build\" is enough"
      ]
    },
    {
      "id": "s5-peak",
      "beat": "s5",
      "kind": "slide",
      "startMs": 20000,
      "durationMs": 5000,
      "intent": "Pick peak-workflow when…",
      "assets": [],
      "text": [
        "Pick peak-workflow when…",
        "you must show each requirement was met",
        "phases, epics, dependencies",
        "verification the implementer can't talk past"
      ]
    }
  ]
