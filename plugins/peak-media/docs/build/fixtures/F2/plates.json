{
  "schemaVersion": 1,
  "spine": "spine/beatgrid.json",
  "brand": "../../../../brand-packs/default",
  "fps": 30,
  "width": 1280,
  "height": 720,
  "plates": [
    {
      "id": "s1-unit",
      "beat": "s1",
      "kind": "slide",
      "startMs": 0,
      "durationMs": 5000,
      "intent": "Unit of work",
      "assets": [],
      "text": [
        "Unit of work",
        "OpenSpec: a change",
        "peak-workflow: an epic in a phased plan"
      ]
    },
    {
      "id": "s2-ids",
      "beat": "s2",
      "kind": "slide",
      "startMs": 5000,
      "durationMs": 5000,
      "intent": "Requirement IDs",
      "assets": [],
      "text": [
        "Requirement IDs",
        "OpenSpec: none",
        "peak-workflow: TOR-NN-XXXXXXX on every scenario"
      ]
    },
    {
      "id": "s3-verify",
      "beat": "s3",
      "kind": "slide",
      "startMs": 10000,
      "durationMs": 5000,
      "intent": "Verification",
      "assets": [],
      "text": [
